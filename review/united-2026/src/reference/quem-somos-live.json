FF1F71\"></stop>\n                                </linearGradient>\n                            </defs>\n                        </svg>\n                        <p>\n                            Ao final do curso, nossos alunos saem preparados para realizar testes reconhecidos internacionalmente e seguir com segurança rumo a novos desafios.\n                        </p>\n\n                        <a href=\"#contato\" class=\"button anchor\">\n                            Vamos Começar!\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"unidades-hibridas wow fadeIn\" style=\"visibility: hidden; animation-name: none;\">\n                <div class=\"container\">\n                    <h2>\n                        Conheça nossas unidades híbridas\n                    </h2>\n                    <p>\n                        Na United, você tem a opção da estrutura física com a flexibilidade do online!\n                    </p>\n\n                    <div class=\"itens\">\n                        <div class=\"item\">\n                                        <div class=\"box\">\n                                            <figure>\n                                                <img src=\"assets/images/geo-alt-fill.png\" alt=\"\">\n                                            </figure>\n                                            <h3>Cornélio Procópio</h3>\n                                            <address>Av. Santos Dumont, 505</address>\n                                            <a href=\"https://wa.me/5543991749855\" target=\"_blank\">(43) 99174-9855</a>\n                                        </div>\n                                    </div><div class=\"item\">\n                                        <div class=\"box\">\n                                            <figure>\n                                                <img src=\"assets/images/geo-alt-fill.png\" alt=\"\">\n          